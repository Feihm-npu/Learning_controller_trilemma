+#!/usr/bin/env python3
+"""Standalone Carr et al. AAAI'23 victim runner (server rebuild).
+
+Keeps all experiment code on the server. Imports upstream model builders and the
+patched TF_Environment from the local repo. Two independent belief trackers are
+created for learn/eval (protocol amendment v1.4/vC).
+"""
+import argparse
+import json
+import os
+import random
+import sys
+import time
+
+import numpy as np
+import stormpy as sp
+
+import gridstorm.models as grid_models
+from shield import build_model, compute_winning_region, construct_otf_shield
+from noshield import NoShield
+from model_simulator import Tracker
+from rl_simulator import TF_Environment
+
+
+def compute_risky_flags(model):
+    """Return bool array: state is risk-adjacent if some available action can
+    transition (with positive probability) into a trap state in one step."""
+    trap_states = set()
+    for s in range(model.nr_states):
+        if "traps" in model.labels_state(s):
+            trap_states.add(s)
+    risky = np.zeros(model.nr_states, dtype=bool)
+    for s in range(model.nr_states):
+        for a in range(model.get_nr_available_actions(s)):
+            ci = model.get_choice_index(s, a)
+            for entry in model.transition_matrix.get_row(ci):
+                if entry.column in trap_states and entry.value() > 0.0:
+                    risky[s] = True
+                    break
+            if risky[s]:
+                break
+    return risky
+
+
+def build_env(model, tracker, seed, poison_spec, args):
+    return TF_Environment(
+        model,
+        tracker,
+        seed=seed,
+        poison_spec=poison_spec,
+        obs_length=1,
+        valuations=args.valuations,
+        obs_type=args.obs_level,
+        maxsteps=args.maxsteps,
+        goal_value=args.goal_value,
+    )
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--grid-model", default="obstacle")
+    p.add_argument("--constants", default="N=6")
+    p.add_argument("--learning-method", default="PPO")
+    p.add_argument("--max-runs", type=int, default=100000)
+    p.add_argument("--maxsteps", type=int, default=100)
+    p.add_argument("--obs-level", default="BELIEF_SUPPORT")
+    p.add_argument("--valuations", action="store_true")
+    p.add_argument("--goal-value", type=int, default=1000)
+    p.add_argument("--seed", type=int, default=101)
+    p.add_argument("--noshield", action="store_true")
+    p.add_argument("--switch-shield", default="HARD", choices=["HARD", "SOFT", "RETAINED"])
+    p.add_argument("--shield-episode", type=int, default=4000)
+    p.add_argument("--eval-interval", type=int, default=1000)
+    p.add_argument("--eval-episodes", type=int, default=10)
+    p.add_argument("--at-retirement-eps", type=int, default=1000)
+    p.add_argument("--final-eval-eps", type=int, default=5000)
+    p.add_argument("--poison-name", default="clean", choices=["clean", "constant", "risk", "contrast"])
+    p.add_argument("--poison-delta", type=float, default=2.0)
+    p.add_argument("--poison-scope", default="shield-on", choices=["full", "shield-on"])
+    p.add_argument("--fname", default="_VICTIM")
+    p.add_argument("--output-dir", required=True)
+    p.add_argument("--no-overwrite", action="store_true", help="refuse if output dir already contains the summary")
+    args = p.parse_args()
+
+    videoname = f"{args.grid_model}-{'-'.join(args.constants.split('='))}-{'noshield' if args.noshield else 'computed-shield'}"
+    out_summary = os.path.join(args.output_dir, f"{videoname}{args.fname}_summary.json")
+    if args.no_overwrite and os.path.exists(out_summary):
+        raise SystemExit(f"Refusing to overwrite existing summary: {out_summary}")
+    os.makedirs(args.output_dir, exist_ok=True)
+
+    # Seeds are also set inside simulate_deep_RL, but set here for shield/model steps.
+    random.seed(args.seed)
+    np.random.seed(args.seed)
+
+    constants = dict(item.split("=") for item in args.constants.split(","))
+    model_fn = getattr(grid_models, args.grid_model)
+    learn_input = model_fn(**constants)
+    eval_input = model_fn(**constants)
+
+    learn_model, _, formula = build_model(learn_input)
+    eval_model, _, _ = build_model(eval_input)
+
+    if args.noshield:
+        otf_shield = NoShield()
+    else:
+        wr = compute_winning_region(learn_model, formula, initial=False)
+        otf_shield = construct_otf_shield(learn_model, wr)
+
+    # Independent belief trackers for learn and eval (v1.4/vC).
+    learn_tracker = Tracker(learn_model, otf_shield)
+    eval_tracker = Tracker(eval_model, otf_shield)
+
+    if args.poison_name == "clean" or args.poison_delta == 0.0:
+        poison_spec = {"name": "clean", "delta": 0.0, "scope": args.poison_scope, "risky_flags": None}
+    else:
+        risky_flags = compute_risky_flags(learn_model)
+        poison_spec = {
+            "name": args.poison_name,
+            "delta": args.poison_delta,
+            "scope": args.poison_scope,
+            "risky_flags": risky_flags,
+        }
+
+    learn_env = build_env(learn_model, learn_tracker, args.seed, poison_spec, args)
+    eval_env = build_env(eval_model, eval_tracker, args.seed, None, args)
+
+    # Switch wiring. For retained/no-shield, never switch. Eval env never switches
+    # by its own loop; final eval is explicitly unshielded.
+    if args.noshield or args.switch_shield == "RETAINED":
+        learn_env.set_shield_switch(-1, "HARD")
+        eval_env.set_shield_switch(-1, "HARD")
+    else:
+        learn_env.set_shield_switch(args.shield_episode, args.switch_shield)
+        eval_env.set_shield_switch(-1, args.switch_shield)
+
+    t0 = time.time()
+    result = learn_env.simulate_deep_RL(
+        None,
+        total_nr_runs=args.max_runs,
+        eval_interval=args.eval_interval,
+        eval_episodes=args.eval_episodes,
+        eval_env=eval_env,
+        agent_arg=args.learning_method,
+        hyper_param=None,
+        at_retirement_eps=args.at_retirement_eps,
+        final_eval_eps=args.final_eval_eps,
+        final_unshielded=(not args.noshield and args.switch_shield != "RETAINED"),
+    )
+    elapsed = time.time() - t0
+
+    base = os.path.join(args.output_dir, f"{videoname}{args.fname}")
+    np.save(base + "_eval_trace.npy", np.asarray(result["eval_trace"], dtype=np.int8))
+    at_trace_file = None
+    if result.get("at_retirement_trace") is not None:
+        at_trace_file = f"{videoname}{args.fname}_at_retirement_trace.npy"
+        np.save(os.path.join(args.output_dir, at_trace_file), np.asarray(result["at_retirement_trace"], dtype=np.int8))
+
+    try:
+        np.savetxt(base + ".csv", np.asarray(result["returns"]), delimiter=" ")
+    except Exception as e:
+        print(f"WARN could not save returns csv: {e}", file=sys.stderr)
+    try:
+        np.savetxt(base + "_Episodes.csv", np.asarray(result["episodes_list"]), delimiter=" ")
+    except Exception as e:
+        print(f"WARN could not save episodes csv: {e}", file=sys.stderr)
+
+    cfg = {
+        "grid_model": args.grid_model,
+        "constants": args.constants,
+        "learning_method": args.learning_method,
+        "max_runs": args.max_runs,
+        "maxsteps": args.maxsteps,
+        "obs_level": args.obs_level,
+        "valuations": args.valuations,
+        "goal_value": args.goal_value,
+        "seed": args.seed,
+        "noshield": args.noshield,
+        "switch_shield": args.switch_shield,
+        "shield_episode": args.shield_episode,
+        "poison": None if args.poison_name == "clean" else {"name": args.poison_name, "delta": args.poison_delta, "scope": args.poison_scope},
+        "eval_interval": args.eval_interval,
+        "eval_episodes": args.eval_episodes,
+        "at_retirement_eps": args.at_retirement_eps,
+        "final_eval_eps": args.final_eval_eps,
+        "fname": args.fname,
+    }
+
+    summary = {
+        "cfg": cfg,
+        "videoname": videoname,
+        "during_violations": result["during_violations"],
+        "during_violation_episodes": result["during_violation_episodes"],
+        "eval_stats": result["eval_stats"],
+        "at_retirement_stats": result["at_retirement_stats"],
+        "disagreement_curve": result["disagreement_curve"],
+        "poison_stats": result["poison_stats"],
+        "poison_scope": args.poison_scope,
+        "eval_trace_file": f"{videoname}{args.fname}_eval_trace.npy",
+        "at_retirement_trace_file": at_trace_file,
+        "wall_time_sec": elapsed,
+    }
+
+    # Make JSON numpy-safe.
+    def _clean(obj):
+        if isinstance(obj, dict):
+            return {k: _clean(v) for k, v in obj.items()}
+        if isinstance(obj, (list, tuple)):
+            return [_clean(v) for v in obj]
+        if isinstance(obj, np.ndarray):
+            return obj.tolist()
+        if isinstance(obj, (np.integer,)):
+            return int(obj)
+        if isinstance(obj, (np.floating,)):
+            return float(obj)
+        if isinstance(obj, (np.bool_,)):
+            return bool(obj)
+        return obj
+
+    summary = _clean(summary)
+    with open(out_summary, "w") as f:
+        json.dump(summary, f, indent=1)
+
+    print(f"DONE seed={args.seed} poison={args.poison_name} delta={args.poison_delta} "
+          f"scope={args.poison_scope} wall={elapsed:.1f}s summary={out_summary}")
+
+
+if __name__ == "__main__":
+    main()
