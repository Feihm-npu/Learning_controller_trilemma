+def evaluate_episodes(env, policy, num_episodes, max_steps=100):
+    env.reset_violation_count()
+    num_violations = 0
+    first_violation_episode = None
+    first_violation_step = None
+    disagreement_steps = 0
+    total_steps = 0
+    violation_trace = np.zeros(num_episodes, dtype=np.int8)
+
+    for ep in range(num_episodes):
+        time_step = env.reset()
+        episode_violated = False
+        step_count = 0
+        while not time_step.is_last():
+            actions = env._simulator.available_actions()
+            safe_actions = env._shield.shielded_actions(range(len(actions)))
+            action_step = policy.action(time_step)
+            action = env.apply_action(action_step.action)
+
+            if action not in safe_actions:
+                disagreement_steps += 1
+            total_steps += 1
+
+            prev_violations = env.no_violations
+            time_step = env.step(action)
+            step_count += 1
+
+            if env.no_violations > prev_violations:
+                episode_violated = True
+                if first_violation_episode is None:
+                    first_violation_episode = ep
+                    first_violation_step = step_count
+
+            if step_count >= max_steps:
+                break
+
+        if episode_violated:
+            num_violations += 1
+            violation_trace[ep] = 1
+
+    violation_fraction = num_violations / num_episodes
+    disagreement_fraction = disagreement_steps / total_steps if total_steps > 0 else 0.0
+    stats = {
+        "num_violations": num_violations,
+        "violation_fraction": violation_fraction,
+        "first_violation_episode": first_violation_episode,
+        "first_violation_step": first_violation_step,
+        "disagreement_fraction": disagreement_fraction,
+    }
+    return stats, violation_trace
+
